<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen's icon: the capsule in a purple disc, on the dark
     chrome. Android 12+ masks this to a circle of 2/3 its size. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="108dp" android:height="108dp" android:gravity="center">
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" android:width="108dp" android:height="108dp" android:gravity="center" />
</layer-list>
