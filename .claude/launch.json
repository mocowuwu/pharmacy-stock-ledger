{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "pharmacy-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "pharmacy-dev-3001",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3001",
        "PGLITE_DIR=.data/pgdata-fresh",
        "npm",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "mobile-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "exec",
        "--",
        "vite",
        "preview",
        "mobile",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}